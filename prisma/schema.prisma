// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model User {
  id           String  @id
  email        String  @unique
  username     String  @unique
  passwordHash String?
  avatarUrl    String?
  bio          String?
  name         String?

  createdAt DateTime @default(now())
}
