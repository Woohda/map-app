generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model User {
  id               String             @id
  email            String             @unique
  username         String             @unique
  passwordHash     String?
  avatarUrl        String?
  name             String
  bio              String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  LocationLogImage LocationLogImage[]
  LocationLog      LocationLog[]
  Location         Location[]
  Session          Session[]
  FavoriteLocation FavoriteLocation[]

  @@map("users")
}

model Session {
  id           String   @id
  userId       String
  expiresAt    DateTime
  activePeriod Int?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Location {
  id               String             @id
  userId           String
  name             String
  slug             String             @unique
  description      String?
  latitude         Float
  longitude        Float
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  LocationLog      LocationLog[]
  FavoriteLocation FavoriteLocation[]
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("locations")
}

model LocationLog {
  id               String             @id
  userId           String
  LocationId       String
  name             String
  description      String?
  startedAt        Int
  endedAt          Int
  latitude         Float
  longitude        Float
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  LocationLogImage LocationLogImage[]
  location         Location           @relation(fields: [LocationId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("location_logs")
}

model LocationLogImage {
  id            String      @id
  userId        String
  locationLogId String
  url           String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  locationLog   LocationLog @relation(fields: [locationLogId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("location_log_images")
}

model FavoriteLocation {
  id        String   @id @default(cuid())
  userId    String
  locationId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@map("favorite_locations")
}
