// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model User {
  id           String  @id
  email        String  @unique
  username     String  @unique
  passwordHash String?
  avatarUrl    String?
  name         String
  bio          String?

  Session          Session[]
  Location         Location[]
  LocationLog      LocationLog[]
  LocationLogImage LocationLogImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Session {
  id           String   @id
  userId       String
  expiresAt    DateTime
  activePeriod Int?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Location {
  id          String        @id
  userId      String
  name        String
  slag        String        @unique
  description String?
  latitude    Float
  longitude   Float
  LocationLog LocationLog[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("locations")
}

model LocationLog {
  id               String             @id
  userId           String
  LocationId       String
  name             String
  description      String?
  startedAt        Int
  endedAt          Int
  latitude         Float
  longitude        Float
  LocationLogImage LocationLogImage[]

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [LocationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("location_logs")
}

model LocationLogImage {
  id            String      @id
  userId        String
  locationLogId String
  url           String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationLog   LocationLog @relation(fields: [locationLogId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("location_log_images")
}
